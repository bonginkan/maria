# =============================================================================
# CRITICAL SECURITY - NEVER COMMIT THESE
# =============================================================================

# ALL environment files - more restrictive for OSS
.env*
!.env.example
!.env.sample
!.env.template
!.env.local.sample
.environment*
config.json
config.*.json
